# Copy this file to .env and fill in real values for local development.
# This file is shared by docker-compose.yml, /backend, and /frontend.

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# Individual fields, used by docker-compose.yml to configure the Postgres container.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=email_job_scheduler
DB_HOST=localhost
DB_PORT=5432
# Full connection string built from the fields above, used by the backend's DB client.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_job_scheduler

# ---------------------------------------------------------------------------
# Redis (job queue / rate-limit counters)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Full connection string used by the backend's Redis client (ioredis/BullMQ, etc).
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# SMTP (Ethereal — fake SMTP inbox for local dev/testing, https://ethereal.email)
# ---------------------------------------------------------------------------
# Generate a throwaway inbox at https://ethereal.email/create and paste the
# credentials below. Emails are captured by Ethereal, not actually delivered.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "From" address used when sending mail through the Ethereal SMTP account above.
SMTP_FROM=

# ---------------------------------------------------------------------------
# Google OAuth (used by NextAuth.js in /frontend for "Login with Google")
# ---------------------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to register there: ${NEXTAUTH_URL}/api/auth/callback/google
# (i.e. http://localhost:3000/api/auth/callback/google for local dev — NextAuth
# builds this itself from NEXTAUTH_URL, there's no separate var for it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# NextAuth.js (frontend session/auth)
# ---------------------------------------------------------------------------
# Base URL NextAuth uses to build OAuth callback/redirect URLs.
NEXTAUTH_URL=http://localhost:3000
# Secret NextAuth uses to sign/encrypt session tokens and cookies.
# Generate one locally with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting / worker configuration
# ---------------------------------------------------------------------------
# Maximum number of emails a single sender account is allowed to send within
# the current clock hour, enforced via a Redis INCR+EXPIRE counter in the
# worker; jobs that would exceed it are rescheduled into the next hour window.
MAX_EMAILS_PER_HOUR_PER_SENDER=100
# Number of scheduled-email jobs the worker processes concurrently.
WORKER_CONCURRENCY=5
# Minimum delay, in milliseconds, enforced between consecutive real sends
# (across all senders) to avoid tripping SMTP provider spam/rate limits.
MIN_DELAY_MS=1000

# ---------------------------------------------------------------------------
# Backend / frontend service config
# ---------------------------------------------------------------------------
# Port the Express API server listens on.
PORT=4000
# Base URL the frontend uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:4000
